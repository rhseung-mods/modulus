{
	"schemaVersion": 1,
	"id": "modulus",
	"version": "${version}",
	"name": "Modulus",
	"description": "Modular Tools and Weapons, and more!",
	"authors": [
		"rhseung"
	],
	"contact": {
		"homepage": "https://modrinth.com/mod/modulus",
		"sources": "https://github.com/rhseung-mods/modulus",
		"issues": "https://github.com/rhseung-mods/modulus/issues"
	},
	"license": "MIT",
	"icon": "assets/modulus/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			{
				"value": "com.rhseung.modulus.Modulus",
				"adapter": "kotlin"
			}
		],
		"client": [
			{
				"value": "com.rhseung.modulus.ModulusClient",
				"adapter": "kotlin"
			}
		],
		"fabric-datagen": [
			{
				"value": "com.rhseung.modulus.ModulusDatagen",
				"adapter": "kotlin"
			}
		]
	},
	"mixins": [
		"modulus.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.16.9",
		"minecraft": "~1.21.3",
		"java": ">=21",
		"fabric-api": "*",
		"fabric-language-kotlin": "*"
	},
	"suggests": {
		"another-mod": "*"
	}
}